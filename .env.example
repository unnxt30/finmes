# Single secrets file for the whole stack. Copy to .env and fill in.
# docker compose generates .hermes/.env from this on every `up`.

# OpenRouter INFERENCE key (not a provisioning key — those 401).
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: web search/scrape for the agent.
FIRECRAWL_API_KEY=

# Bearer token the iPhone shortcut sends to POST /ingest. Any long random string.
FINMES_INGEST_TOKEN=

# Auth for the Hermes gateway HTTP API on 8642. Any long random string.
API_SERVER_KEY=

# Optional: Discord chat with the agent. Leave blank to skip.
# Bot token from discord.com/developers (Bot tab; enable Message Content intent).
DISCORD_BOT_TOKEN=
# Your Discord user ID (right-click your name with Developer Mode on) — only
# these users can talk to the agent.
DISCORD_ALLOWED_USERS=
# Channel ID where cron digests land (right-click channel -> Copy Channel ID).
DISCORD_HOME_CHANNEL=
